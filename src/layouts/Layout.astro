---
// src/layouts/Layout.astro
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "生徒会防災サミット | Think BIG, We’ll Go Further",
  description = "全国の中学生・高校生が地域と学校を越えて集い、次世代の防災スタンダードを創るプラットフォーム。主催：特定非営利活動法人日本若者防災復興協会（JYRAC）"
} = Astro.props;

const cleanBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
const faviconPath = `${cleanBase}/logo.png`;
---

<!doctype html>
<html lang="ja" class="scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={faviconPath} />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Webフォント -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Zen+Kaku+Gothic+New:wght@500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="relative bg-slate-50 text-slate-800 font-sans antialiased selection:bg-blue-600 selection:text-white min-h-screen w-full overflow-x-hidden flex flex-col">
    
    <!-- 背景装飾（スマホ幅でも絶対に飛び出さないレスポンシブ幅） -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[340px] sm:w-[600px] md:w-[850px] h-[280px] sm:h-[450px] bg-gradient-to-tr from-blue-200/40 via-sky-100/30 to-transparent blur-3xl rounded-full"></div>
      <div class="w-full h-full bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:24px_24px] opacity-60"></div>
    </div>

    <!-- コンテンツスロット（w-full と min-w-0 を追加し横崩れを防止） -->
    <div class="relative z-10 flex-1 flex flex-col w-full min-w-0">
      <slot />
    </div>

  </body>
</html>
