---
// src/components/NoteFeed.astro
const MAGAZINE_URL = "https://note.com/jyrac_official/m/m356b681c3cfd";
const RSS_URL = `${MAGAZINE_URL}/rss`;
---

<section class="space-y-3 text-left" id="note-section">
  <!-- ヘッダーバー -->
  <div class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
    <div class="flex items-center gap-2.5">
      <span class="w-2 h-2 rounded-full bg-blue-600"></span>
      <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight">
        お知らせ・活動報告
      </h2>
      <span class="text-[10px] font-mono font-bold text-slate-400 uppercase tracking-widest hidden sm:inline">
        NEWS & REPORT
      </span>
    </div>
    <a
      href={MAGAZINE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-xs font-bold text-slate-500 hover:text-blue-600 transition no-underline"
    >
      <span>note一覧を見る</span>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>

  <!-- リストコンテナ（JSで最大6件を自動注入） -->
  <div id="note-articles-container" class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/80 shadow-xs divide-y divide-slate-100 overflow-hidden">
    <!-- ローディング用スケルトン（読み込み中に表示） -->
    <div class="p-3.5 sm:p-4 space-y-2 animate-pulse">
      <div class="h-3 bg-slate-200 rounded w-1/4"></div>
      <div class="h-4 bg-slate-200 rounded w-3/4"></div>
    </div>
    <div class="p-3.5 sm:p-4 space-y-2 animate-pulse">
      <div class="h-3 bg-slate-200 rounded w-1/4"></div>
      <div class="h-4 bg-slate-200 rounded w-2/3"></div>
    </div>
    <div class="p-3.5 sm:p-4 space-y-2 animate-pulse">
      <div class="h-3 bg-slate-200 rounded w-1/4"></div>
      <div class="h-4 bg-slate-200 rounded w-3/5"></div>
    </div>
  </div>
</section>

<!-- クライアントサイド自動取得スクリプト -->
<script define:vars={{ RSS_URL, MAGAZINE_URL }}>
  async function loadNoteList() {
    const container = document.getElementById('note-articles-container');
    if (!container) return;

    try {
      // CORSを回避してRSSをリアルタイム取得
      const endpoint = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(RSS_URL)}`;
      const res = await fetch(endpoint);
      const data = await res.json();

      if (data.status === 'ok' && data.items && data.items.length > 0) {
        // 最新6件を抽出（5〜6件）
        const latestItems = data.items.slice(0, 6);

        container.innerHTML = latestItems.map((item, idx) => {
          // 日付フォーマット (YYYY.MM.DD)
          const d = new Date(item.pubDate);
          const dateStr = !isNaN(d.getTime())
            ? `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`
            : '';

          // 著者・発信元
          const creator = item.author || 'JYRAC';

          return `
            <a
              href="${item.link}"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 sm:gap-4 p-3.5 sm:p-4 hover:bg-slate-50/80 transition duration-150 no-underline"
            >
              <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-3 min-w-0">
                <!-- 日付とバッジ -->
                <div class="flex items-center gap-2 shrink-0">
                  <span class="text-[11px] sm:text-xs font-mono font-bold text-slate-400">
                    ${dateStr}
                  </span>
                  <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-[10px] font-bold">
                    ${creator}
                  </span>
                </div>

                <!-- 記事タイトル -->
                <span class="font-bold text-xs sm:text-sm text-slate-800 group-hover:text-blue-600 transition truncate">
                  ${item.title}
                </span>
              </div>

              <!-- 右端の矢印アイコン -->
              <div class="hidden sm:flex items-center text-slate-300 group-hover:text-blue-600 group-hover:translate-x-0.5 transition duration-150 shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          `;
        }).join('');
      } else {
        // 記事がまだ投稿されていない場合
        container.innerHTML = `
          <div class="p-6 text-center space-y-1.5">
            <p class="text-xs text-slate-500 font-medium">現在、最新のお知らせ・報告事項を準備中です。</p>
            <a href="${MAGAZINE_URL}" target="_blank" rel="noopener noreferrer" class="inline-block text-xs font-bold text-blue-600 hover:underline">
              公式noteマガジンはこちら →
            </a>
          </div>
        `;
      }
    } catch (err) {
      console.error('noteフィードの読み込みに失敗しました:', err);
      container.innerHTML = `
        <div class="p-5 text-center space-y-1">
          <p class="text-xs text-slate-400">お知らせの読み込みに失敗しました。</p>
          <a href="${MAGAZINE_URL}" target="_blank" rel="noopener noreferrer" class="inline-block text-xs font-bold text-blue-600 hover:underline">
            noteで直接確認する →
          </a>
        </div>
      `;
    }
  }

  loadNoteList();
</script>
