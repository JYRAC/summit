---
// src/pages/organizer.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const cleanBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Layout title="主催・運営体制 | 生徒会防災サミット" description="特定非営利活動法人日本若者防災復興協会（JYRAC）について。">
  <Header />

  <main id="main-content" class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-16 space-y-8 text-left">
    
    <div class="text-center space-y-2">
      <p class="text-[11px] sm:text-xs font-black tracking-widest text-slate-400 uppercase font-mono">Organizer</p>
      <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">主催組織</h1>
    </div>

    <div class="bg-white p-6 sm:p-10 rounded-2xl sm:rounded-3xl border border-slate-200 shadow-xs space-y-3">
      <span class="text-[11px] sm:text-xs font-black text-blue-600 tracking-wider uppercase font-mono">
        SUMMIT FOUNDER & ORGANIZER
      </span>
      <h2 class="text-lg sm:text-xl font-black text-slate-900">
        特定非営利活動法人日本若者防災復興協会（JYRAC）
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
        若者の力を結集し、次世代主導の防災教育・被災地支援・地域コミュニティのレジリエンス向上を推進するNPO法人。全国の学生ネットワークと共に、持続可能な防災アクションを形にしています。
      </p>
    </div>

    <div class="pt-4 text-center">
      <a href={`${cleanBase}/`} class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-blue-600 no-underline transition">
        <span>← トップページに戻る</span>
      </a>
    </div>

  </main>

  <Footer />
</Layout>
