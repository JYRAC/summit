---
// src/pages/schedule.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const cleanBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Layout title="サミット開催日程 | 生徒会防災サミット" description="生徒会防災サミット2026 秋の陣（DAY1〜DAY3）および本陣の開催日程一覧。">
  <Header />

  <main id="main-content" class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16 space-y-8 sm:space-y-10 text-left">
    
    <div class="text-center space-y-2">
      <span class="text-xs font-mono font-bold text-blue-600 uppercase tracking-widest">SCHEDULE</span>
      <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">サミット開催日程</h1>
    </div>

    <!-- DAY 1 メインカード -->
    <div class="relative overflow-hidden bg-white/95 rounded-2xl sm:rounded-3xl p-5 sm:p-8 border border-slate-200/90 shadow-[0_12px_36px_rgba(15,23,42,0.05)]">
      <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-orange-400 via-blue-500 to-emerald-400"></div>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5">
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-slate-900 text-white text-[9px] sm:text-[10px] font-black tracking-widest uppercase font-mono">
              NEXT SUMMIT
            </span>
            <span class="text-[11px] sm:text-xs font-bold text-orange-600 bg-orange-50 px-2 py-0.5 rounded border border-orange-100">
              DAY 1 エントリー受付中
            </span>
          </div>
          
          <a href={`${cleanBase}/autumn/day1`} class="block no-underline group/title">
            <h2 class="text-lg sm:text-xl font-black text-slate-900 group-hover/title:text-blue-600 transition tracking-tight">
              生徒会防災サミット2026 秋の陣 DAY１
            </h2>
          </a>
          
          <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 text-xs font-semibold text-slate-600">
            <span class="text-blue-600 font-mono font-bold">2026.09.13 (Sun) 17:00–18:50</span>
            <span class="text-slate-300 hidden sm:inline">/</span>
            <span>Zoom オンライン開催（全国どこからでも参加可能）</span>
          </div>
        </div>

        <a href={`${cleanBase}/autumn/day1`} class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-xs sm:text-sm font-bold no-underline shadow-md hover:scale-[1.02] transition shrink-0">
          <span>企画詳細・エントリーを見る</span>
        </a>
      </div>

      <!-- DAY1 タイムテーブル概要 -->
      <div class="mt-6 pt-5 border-t border-slate-100 text-left space-y-3">
        <span class="text-[11px] font-black tracking-wider text-slate-400 uppercase font-mono">DAY 1 PROGRAM / タイムテーブル</span>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs">
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
            <span class="font-mono font-bold text-slate-500 text-[11px]">17:00 – 17:10</span>
            <p class="font-bold text-slate-800">開会・開会の言葉</p>
            <p class="text-[11px] text-slate-500">実行委員長：梁川 正光 による開会挨拶</p>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
            <span class="font-mono font-bold text-blue-600 text-[11px]">17:10 – 18:15</span>
            <p class="font-bold text-slate-800">卜部教授 特別講演会</p>
            <p class="text-[11px] text-slate-500">新潟大学 災害・復興科学研究所より「地域と防災」＋質疑応答</p>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
            <span class="font-mono font-bold text-indigo-600 text-[11px]">18:15 – 18:45</span>
            <p class="font-bold text-slate-800">グループディスカッション</p>
            <p class="text-[11px] text-slate-500">極力地域別のブレイクアウトルームで全国の仲間と対話・ワーク</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 10月(DAY 2)・11月(DAY 3) 開催予告カード -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
      <!-- 10月予告: DAY 2 -->
      <a href={`${cleanBase}/autumn/day2`} class="relative overflow-hidden rounded-2xl bg-white hover:bg-slate-50 p-5 border border-dashed border-slate-300 hover:border-blue-400 shadow-xs flex flex-col justify-between space-y-3 no-underline group transition">
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="px-2 py-0.5 rounded bg-blue-100 text-blue-700 text-[10px] font-mono font-black">
              OCTOBER 2026
            </span>
            <span class="text-[9px] font-mono font-bold text-slate-400 uppercase tracking-wider">
              Coming soon...
            </span>
          </div>
          <h3 class="font-black text-slate-900 group-hover:text-blue-600 transition text-sm">生徒会防災サミット2026 秋の陣 DAY２</h3>
          <p class="text-[11px] text-slate-500 leading-relaxed">
            DAY 1の議論を受け、学校連携アクションや地域別プロジェクトを始動する実践セッション。
          </p>
        </div>
        <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-400 font-medium">
          <span class="text-blue-600 font-bold group-hover:underline">詳細・予告を見る →</span>
          <span class="text-blue-600 font-bold font-mono">DAY 2</span>
        </div>
      </a>

      <!-- 11月予告: DAY 3 -->
      <a href={`${cleanBase}/autumn/day3`} class="relative overflow-hidden rounded-2xl bg-white hover:bg-slate-50 p-5 border border-dashed border-slate-300 hover:border-indigo-400 shadow-xs flex flex-col justify-between space-y-3 no-underline group transition">
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="px-2 py-0.5 rounded bg-indigo-100 text-indigo-700 text-[10px] font-mono font-black">
              NOVEMBER 2026
            </span>
            <span class="text-[9px] font-mono font-bold text-slate-400 uppercase tracking-wider">
              Coming soon...
            </span>
          </div>
          <h3 class="font-black text-slate-900 group-hover:text-indigo-600 transition text-sm">全国生徒会防災サミット2026 秋の陣 DAY３</h3>
          <p class="text-[11px] text-slate-500 leading-relaxed">
            秋の陣の集大成。全国の中高生による実践成果の発表、社会への共同提言を取りまとめます。
          </p>
        </div>
        <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-400 font-medium">
          <span class="text-indigo-600 font-bold group-hover:underline">詳細・予告を見る →</span>
          <span class="text-indigo-600 font-bold font-mono">DAY 3</span>
        </div>
      </a>
    </div>

    <!-- 本陣予告バナー -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-amber-500/10 via-orange-500/5 to-transparent border border-amber-200/80 p-5 text-left flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded bg-amber-600 text-white text-[9px] font-mono font-black tracking-wider uppercase">
            MAIN SUMMIT
          </span>
          <span class="text-[11px] font-bold text-amber-800">開催時期：未定（企画進行中）</span>
        </div>
        <h3 class="text-base font-black text-slate-900">生徒会防災サミット 本陣</h3>
        <p class="text-xs text-slate-500">
          秋の陣の全成果を結集する年次メインイベント。開催日程・詳細は決定次第発表します。
        </p>
      </div>
      <a
        href={`${cleanBase}/honjin`}
        class="inline-flex items-center justify-center gap-1 px-4 py-2 rounded-xl bg-white border border-amber-300 text-amber-900 hover:text-blue-600 hover:border-blue-400 text-xs font-bold transition shrink-0 no-underline shadow-2xs"
      >
        <span>本陣の構想を見る →</span>
      </a>
    </div>

    <div class="pt-4 text-center">
      <a href={`${cleanBase}/`} class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-blue-600 no-underline transition">
        <span>← トップページに戻る</span>
      </a>
    </div>

  </main>

  <Footer />
</Layout>
