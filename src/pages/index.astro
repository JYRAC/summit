---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

const cleanBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
const logoPath = `${cleanBase}/logo.png`;
---

<Layout title="全国生徒会防災サミット | Think BIG, We’ll Go Further" description="“Think BIG, We’ll Go Further” 全国の中学生・高校生が地域と学校を越えて集い、次世代の防災スタンダードを創るプラットフォーム。主催：特定非営利活動法人日本若者防災復興協会（JYRAC）">
  <!-- ナビゲーションバー -->
  <header class="sticky top-0 z-[120] bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
      
      <!-- ロゴ＆タイトル -->
      <a href={`${cleanBase}/`} class="flex items-center gap-2.5 sm:gap-3 no-underline group select-none min-w-0">
        <div class="relative flex items-center justify-center shrink-0">
          <div class="absolute -inset-1 bg-gradient-to-tr from-orange-400 via-sky-400 to-emerald-400 rounded-full blur-xs opacity-60 group-hover:opacity-100 transition duration-300"></div>
          <img
            src={logoPath}
            alt="ロゴ"
            class="relative w-8 h-8 sm:w-10 sm:h-10 object-contain rounded-full shadow-2xs"
          />
        </div>
        <div class="flex flex-col truncate">
          <span class="font-black text-slate-900 tracking-tight text-sm sm:text-lg leading-tight group-hover:text-blue-600 transition truncate">
            全国生徒会防災サミット
          </span>
          <span class="text-[8px] sm:text-[9px] font-black tracking-widest text-blue-600 uppercase mt-0.5 font-mono">
            Think BIG, We’ll Go Further
          </span>
        </div>
      </a>

      <!-- PC用ナビゲーション -->
      <nav class="hidden md:flex items-center gap-1.5 p-1.5 bg-slate-100/70 border border-slate-200/60 rounded-full backdrop-blur-md">
        <a href="#statement" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-600 hover:text-blue-600 hover:bg-white no-underline transition shadow-2xs">
          理念
        </a>
        <a href="#about" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-600 hover:text-blue-600 hover:bg-white no-underline transition shadow-2xs">
          3つの柱
        </a>
        <a href="#program" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-600 hover:text-blue-600 hover:bg-white no-underline transition shadow-2xs">
          開催日程
        </a>
        <a href="#organizer" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-600 hover:text-blue-600 hover:bg-white no-underline transition shadow-2xs">
          運営体制
        </a>
        <a href="#contact" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-600 hover:text-blue-600 hover:bg-white no-underline transition shadow-2xs">
          お問い合わせ
        </a>
        <a href="https://www.instagram.com/pred.studentsummit" target="_blank" rel="noopener noreferrer"
          class="ml-1 px-4 py-1.5 rounded-full bg-slate-900 hover:bg-blue-600 text-white text-xs font-bold no-underline transition shadow-xs flex items-center gap-1">
          <span>Instagram</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </nav>

      <!-- モバイル用トグルボタン -->
      <button id="menu-toggle" type="button" aria-label="メニューを開閉" class="md:hidden relative z-[130] w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 shadow-xs active:scale-95 transition">
        <svg id="icon-open" class="w-5 h-5 text-slate-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-5 h-5 text-slate-800 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </header>

  <!-- モバイル用フルスクリーンメニュー -->
  <div id="mobile-menu" class="fixed inset-0 w-full h-full z-[110] bg-white flex-col justify-between px-6 pt-24 pb-8 hidden md:hidden overflow-y-auto">
    <nav class="flex flex-col space-y-4 pt-2">
      <div class="flex flex-col space-y-1 pb-2 border-b border-slate-100">
        <span class="text-[10px] font-black tracking-widest text-slate-400 uppercase">SLOGAN</span>
        <span class="text-xs font-mono font-bold text-blue-600">“Think BIG, We’ll Go Further”</span>
      </div>
      
      <a href="#statement" class="mobile-nav-link text-xl font-black text-slate-900 no-underline hover:text-blue-600 transition flex items-center justify-between py-3 border-b border-slate-100">
        <span>理念（Core Philosophy）</span>
        <span class="text-xs font-mono text-slate-400">01</span>
      </a>
      <a href="#about" class="mobile-nav-link text-xl font-black text-slate-900 no-underline hover:text-blue-600 transition flex items-center justify-between py-3 border-b border-slate-100">
        <span>3つの柱</span>
        <span class="text-xs font-mono text-slate-400">02</span>
      </a>
      <a href="#program" class="mobile-nav-link text-xl font-black text-slate-900 no-underline hover:text-blue-600 transition flex items-center justify-between py-3 border-b border-slate-100">
        <span>サミット開催日程</span>
        <span class="text-xs font-mono text-slate-400">03</span>
      </a>
      <a href="#organizer" class="mobile-nav-link text-xl font-black text-slate-900 no-underline hover:text-blue-600 transition flex items-center justify-between py-3 border-b border-slate-100">
        <span>主催・運営体制</span>
        <span class="text-xs font-mono text-slate-400">04</span>
      </a>
      <a href="#contact" class="mobile-nav-link text-xl font-black text-slate-900 no-underline hover:text-blue-600 transition flex items-center justify-between py-3 border-b border-slate-100">
        <span>お問い合わせ</span>
        <span class="text-xs font-mono text-slate-400">05</span>
      </a>
    </nav>

    <div class="pt-6 border-t border-slate-200 space-y-3">
      <a href="https://www.instagram.com/pred.studentsummit" target="_blank" rel="noopener noreferrer" class="w-full py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm no-underline shadow-md flex items-center justify-center gap-2 active:scale-98 transition">
        <span>公式Instagramを見る</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <p class="text-center text-[10px] text-slate-400 font-medium">
        © 2026 全国生徒会防災サミット
      </p>
    </div>
  </div>

  <!-- メインコンテンツ -->
  <main id="main-content" class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-16 space-y-20 sm:space-y-32 overflow-x-hidden">
    
    <!-- ヒーローセクション -->
    <section class="relative pt-4 sm:pt-10 pb-4 w-full">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] sm:w-[600px] h-[220px] sm:h-[350px] bg-gradient-to-tr from-emerald-200/35 via-sky-200/40 to-orange-200/35 blur-3xl pointer-events-none -z-10 rounded-full"></div>

      <div class="relative z-10 flex flex-col items-center text-center max-w-4xl mx-auto space-y-6 sm:space-y-8">
        
        <!-- 中央シンボルロゴ -->
        <div class="relative flex items-center justify-center group">
          <div class="absolute -inset-3 sm:-inset-4 bg-gradient-to-tr from-emerald-400 via-sky-400 to-orange-400 rounded-full blur-xl sm:blur-2xl opacity-40 group-hover:opacity-70 transition duration-500"></div>
          <img src={logoPath} alt="全国生徒会防災サミット シンボルマーク" class="relative w-20 h-20 sm:w-32 sm:h-32 object-contain rounded-full shadow-[0_8px_24px_rgba(0,0,0,0.08)] transform group-hover:scale-105 transition duration-300" />
        </div>

        <!-- キャッチコピー＆全体スローガン -->
        <div class="space-y-3 sm:space-y-4 px-2">
          <!-- 全体スローガンバッジ -->
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/90 border border-blue-200/80 shadow-xs">
            <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
            <span class="text-xs sm:text-sm font-black tracking-wide bg-gradient-to-r from-blue-700 to-indigo-700 bg-clip-text text-transparent font-mono">
              “Think BIG, We’ll Go Further”
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-slate-900 tracking-tight leading-[1.2] break-words">
            「守られる側」から、<br />
            <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-teal-500 bg-clip-text text-transparent">
              未来を動かす側へ。
            </span>
          </h1>

          <p class="max-w-2xl mx-auto text-xs sm:text-base text-slate-600 leading-relaxed font-medium">
            教科書通りの避難訓練、本当に現場で役に立つ？<br class="hidden sm:inline" />
            災害が起きた瞬間、学校や地域を実際に動かすのは大人だけじゃない。<br class="hidden sm:inline" />
            全国の生徒会がつながり、リアルな知恵を本音でぶつけ合う、中高生のためのサミット。
          </p>
        </div>

        <!-- サミット日程エリア（DAY 1 メイン + DAY 2・DAY 3 予告 + 本陣バナー） -->
        <div id="program" class="pt-2 w-full max-w-3xl mx-auto scroll-mt-24 space-y-4">
          
          <!-- 9月特大イベントカード（DAY 1 メイン） -->
          <div class="relative overflow-hidden bg-white/95 rounded-2xl sm:rounded-3xl p-5 sm:p-8 border border-slate-200/90 shadow-[0_12px_36px_rgba(15,23,42,0.05)]">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-orange-400 via-blue-500 to-emerald-400"></div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5 text-left">
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-slate-900 text-white text-[9px] sm:text-[10px] font-black tracking-widest uppercase">
                    NEXT SUMMIT
                  </span>
                  <span class="text-[11px] sm:text-xs font-bold text-orange-600 bg-orange-50 px-2 py-0.5 rounded border border-orange-100">
                    DAY 1 エントリー受付中
                  </span>
                </div>
                
                <a href={`${cleanBase}/autumn/day1`} class="block no-underline group/title">
                  <h3 class="text-lg sm:text-xl font-black text-slate-900 group-hover/title:text-blue-600 transition tracking-tight">
                    全国生徒会防災サミット2026 秋の陣 DAY１
                  </h3>
                </a>
                
                <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 text-xs font-semibold text-slate-600">
                  <span class="text-blue-600 font-mono font-bold">2026.09.13 (Sun) 17:00–18:50</span>
                  <span class="text-slate-300 hidden sm:inline">/</span>
                  <span>Zoom オンライン開催（全国どこからでも参加可能）</span>
                </div>
              </div>

              <!-- CTAボタン（DAY 1 詳細ページへ遷移） -->
              <a href={`${cleanBase}/autumn/day1`} class="relative inline-flex items-center justify-center p-0.5 overflow-hidden rounded-xl sm:rounded-2xl group shrink-0 w-full sm:w-auto no-underline">
                <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-blue-600 via-indigo-600 to-sky-400 rounded-xl sm:rounded-2xl blur-xs opacity-60 group-hover:opacity-100 transition duration-300"></span>
                <span class="relative w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl sm:rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-xs sm:text-sm font-bold shadow-md transition duration-200 group-hover:scale-[1.02] active:scale-[0.98]">
                  <span>企画詳細・エントリーを見る</span>
                  <svg class="w-3.5 h-3.5 transition duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </span>
              </a>
            </div>

            <!-- DAY1 タイムテーブル -->
            <div class="mt-6 pt-5 border-t border-slate-100 text-left space-y-3">
              <span class="text-[11px] font-black tracking-wider text-slate-400 uppercase">DAY 1 PROGRAM / タイムテーブル</span>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs">
                <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
                  <span class="font-mono font-bold text-blue-600 text-[11px]">17:10 – 18:15</span>
                  <p class="font-bold text-slate-800">卜部教授 特別講演</p>
                  <p class="text-[11px] text-slate-500">新潟大学 災害・復興科学研究所より「地域と防災」</p>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
                  <span class="font-mono font-bold text-indigo-600 text-[11px]">18:15 – 18:45</span>
                  <p class="font-bold text-slate-800">防災ゲーム「HUG Gioco」</p>
                  <p class="text-[11px] text-slate-500">オリジナルゲームで迅速な判断力をチーム体験</p>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
                  <span class="font-mono font-bold text-teal-600 text-[11px]">18:15 – 18:45</span>
                  <p class="font-bold text-slate-800">理想の街ディスカッション</p>
                  <p class="text-[11px] text-slate-500">全国の生徒会と地域のリアルな防災課題を討議</p>
                </div>
              </div>
            </div>

            <div class="mt-5 pt-3.5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-[10px] sm:text-[11px] text-slate-400">
              <span>主催：特定非営利活動法人日本若者防災復興協会（JYRAC）</span>
              <span>対象：全国の中学・高校生 / 参加費：無料</span>
            </div>
          </div>

          <!-- 10月(DAY 2)・11月(DAY 3) 開催予告カード -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
            <!-- 10月予告: DAY 2 -->
            <a href={`${cleanBase}/autumn/day2`} class="relative overflow-hidden rounded-2xl bg-white/85 hover:bg-white backdrop-blur-sm p-5 border border-dashed border-slate-300 hover:border-blue-400 shadow-xs flex flex-col justify-between space-y-3 no-underline group transition">
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <span class="px-2 py-0.5 rounded bg-blue-100 text-blue-700 text-[10px] font-mono font-black">
                    OCTOBER 2026
                  </span>
                  <span class="text-[9px] font-mono font-bold text-slate-400 uppercase tracking-wider">
                    Coming soon...
                  </span>
                </div>
                <h4 class="font-black text-slate-900 group-hover:text-blue-600 transition text-sm">全国生徒会防災サミット2026 秋の陣 DAY２</h4>
                <p class="text-[11px] text-slate-500 leading-relaxed">
                  DAY 1の議論を受け、学校連携アクションや地域別プロジェクトを始動する実践セッション。
                </p>
              </div>
              <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-400 font-medium">
                <span class="text-blue-600 font-bold group-hover:underline">詳細・予告を見る →</span>
                <span class="text-blue-600 font-bold font-mono">DAY 2</span>
              </div>
            </a>

            <!-- 11月予告: DAY 3 -->
            <a href={`${cleanBase}/autumn/day3`} class="relative overflow-hidden rounded-2xl bg-white/85 hover:bg-white backdrop-blur-sm p-5 border border-dashed border-slate-300 hover:border-indigo-400 shadow-xs flex flex-col justify-between space-y-3 no-underline group transition">
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <span class="px-2 py-0.5 rounded bg-indigo-100 text-indigo-700 text-[10px] font-mono font-black">
                    NOVEMBER 2026
                  </span>
                  <span class="text-[9px] font-mono font-bold text-slate-400 uppercase tracking-wider">
                    Coming soon...
                  </span>
                </div>
                <h4 class="font-black text-slate-900 group-hover:text-indigo-600 transition text-sm">全国生徒会防災サミット2026 秋の陣 DAY３</h4>
                <p class="text-[11px] text-slate-500 leading-relaxed">
                  秋の陣の集大成。全国の中高生による実践成果の発表、社会への共同提言を取りまとめます。
                </p>
              </div>
              <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-400 font-medium">
                <span class="text-indigo-600 font-bold group-hover:underline">詳細・予告を見る →</span>
                <span class="text-indigo-600 font-bold font-mono">DAY 3</span>
              </div>
            </a>
          </div>

          <!-- 本陣（グランドサミット）予告バナー：開催時期未定 -->
          <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-amber-500/10 via-orange-500/5 to-transparent border border-amber-200/80 p-5 text-left flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded bg-amber-600 text-white text-[9px] font-mono font-black tracking-wider uppercase">
                  GRAND SUMMIT
                </span>
                <span class="text-[11px] font-bold text-amber-800">開催時期：未定（企画進行中）</span>
              </div>
              <h4 class="text-base font-black text-slate-900">全国生徒会防災サミット 本陣（グランドサミット）</h4>
              <p class="text-xs text-slate-500">
                秋の陣の全成果を結集する年次メイン大会。開催日程・詳細は決定次第発表します。
              </p>
            </div>
            <a
              href={`${cleanBase}/honjin`}
              class="inline-flex items-center justify-center gap-1 px-4 py-2 rounded-xl bg-white border border-amber-300 text-amber-900 hover:text-blue-600 hover:border-blue-400 text-xs font-bold transition shrink-0 no-underline shadow-2xs"
            >
              <span>本陣の構想を見る →</span>
            </a>
          </div>

        </div>

      </div>
    </section>

    <!-- 理念（Core Philosophy）セクション -->
    <section id="statement" class="space-y-6 sm:space-y-10 scroll-mt-20">
      
      <!-- 理念ヘッダー -->
      <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-white/95 backdrop-blur-md p-6 sm:p-12 border border-slate-200/90 shadow-xs text-left">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-orange-400 via-blue-500 to-emerald-400"></div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-bold tracking-widest uppercase mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
          CORE PHILOSOPHY
        </div>

        <h2 class="text-xl sm:text-3xl md:text-4xl font-black text-slate-900 tracking-tight leading-snug mb-4">
          Resilience, Stewardship, and Cultivation
        </h2>
        
        <p class="text-xs sm:text-base font-bold text-slate-700 leading-relaxed bg-slate-50 p-4 sm:p-5 rounded-xl border-l-4 border-blue-600">
          — 私たちは、災害に対する強靭さ（Resilience）を持ち、学校と地域の未来を担う責任ある存在（Stewardship）として、防災を日常に根づかせる文化（Cultivation）を育てていきます。
        </p>
      </div>

      <!-- 理念3要素の解説ブロック -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-left">
        
        <!-- 01 Resilience -->
        <div class="relative bg-white p-6 sm:p-8 rounded-2xl sm:rounded-3xl border border-slate-200 shadow-xs flex flex-col justify-between overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-orange-500"></div>
          <div class="space-y-3.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black font-mono tracking-widest text-orange-600 uppercase">PHILOSOPHY 01</span>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-orange-50 text-orange-700 border border-orange-100">強靭さ</span>
            </div>
            <h3 class="text-xl font-black text-slate-900 tracking-tight">Resilience</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
              全国生徒会防災サミットは、災害という不可避のリスクに対して、事後的に対応するのではなく、事前に備える力＝Resilienceを中高生自身が自らの手で高めていくことを目的としています。学校における防災教育は、多くの場合“受動的”な講義や訓練にとどまりがちですが、このサミットでは、生徒会という当事者が「主体的に企画し、提案し、実践する」経験を通じて、危機を想定し、それに向き合う“構え”を文化として定着させることを重視しています。自分たちの学校の課題に合わせてアイデアを出し合い、現実的なアクションへと落とし込むプロセスそのものが、未来への“しなやかな強さ”を育てるResilienceの実践なのです。
            </p>
          </div>
        </div>

        <!-- 02 Stewardship -->
