---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

const cleanBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
const logoPath = `${cleanBase}/logo.png`;
---

<Layout
  title="全国生徒会防災サミット | 公式サイト"
  description="全国の中学生・高校生が地域と学校を越えて集い、次世代の防災スタンダードを創るプラットフォーム。主催：特定非営利活動法人日本若者防災復興協会（JYRAC）"
>
  <!-- ナビゲーションバー -->
  <header class="sticky top-0 z-[120] bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
      
      <!-- ロゴ＆タイトル -->
      <a href={`${cleanBase}/`} class="flex items-center gap-2.5 sm:gap-3 no-underline group select-none min-w-0">
        <div class="relative flex items-center justify-center shrink-0">
          <div class="absolute -inset-1 bg-gradient-to-tr from-orange-400 via-sky-400 to-emerald-400 rounded-full blur-xs opacity-60 group-hover:opacity-100 transition duration-300"></div>
          <img
            src={logoPath}
            alt="ロゴ"
            class="relative w-8 h-8 sm:w-10 sm:h-10 object-contain rounded-full shadow-2xs"
          />
        </div>
        <div class="flex flex-col truncate">
          <span class="font-black text-slate-900 tracking-tight text-sm sm:text-lg leading-tight group-hover:text-blue-600 transition truncate">
            全国生徒会防災サミット
          </span>
          <span class="text-[8px] sm:text-[9px] font-black tracking-widest text-slate-400 uppercase mt-0.5">
            National Student Summit
          </span>
        </div>
      </a>

      <!-- PC用ナビゲーション -->
      <nav class="hidden md:flex items-center gap-1.5 p-1.5 bg-slate-100/70 border border-slate-200/60 rounded-full backdrop-blur-md">
        <a href="#statement" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-600 hover:text-blue-600 hover:bg-white no-underline transition shadow-2xs">
          理念宣言
        </a>
        <a href="#about" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-600 hover:text-blue-600 hover:bg-white no-underline transition shadow-2xs">
          3つの柱
        </a>
        <a href="#events" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-600 hover:text-blue-600 hover:bg-white no-underline transition shadow-2xs">
          開催一覧
        </a>
        <a href="#organizer" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-600 hover:text-blue-600 hover:bg-white no-underline transition shadow-2xs">
          運営体制
        </a>
        <a href="#contact" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-600 hover:text-blue-600 hover:bg-white no-underline transition shadow-2xs">
          お問い合わせ
        </a>
        <a
          href="https://www.instagram.com/pred.studentsummit"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-1 px-4 py-1.5 rounded-full bg-slate-900 hover:bg-blue-600 text-white text-xs font-bold no-underline transition shadow-xs flex items-center gap-1"
        >
          <span>Instagram</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </nav>

      <!-- モバイル用トグルボタン -->
      <button
        id="menu-toggle"
        type="button"
        aria-label="メニューを開閉"
        class="md:hidden relative z-[130] w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 shadow-xs active:scale-95 transition"
      >
        <svg id="icon-open" class="w-5 h-5 text-slate-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-5 h-5 text-slate-800 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </header>

  <!-- モバイル用フルスクリーンメニュー（不透明度100%の白背景で完全遮断） -->
  <div
    id="mobile-menu"
    class="fixed inset-0 w-full h-full z-[110] bg-white flex-col justify-between px-6 pt-24 pb-8 hidden md:hidden overflow-y-auto"
  >
    <nav class="flex flex-col space-y-4 pt-2">
      <span class="text-[10px] font-black tracking-widest text-slate-400 uppercase">MENU NAVIGATION</span>
      <a href="#statement" class="mobile-nav-link text-xl font-black text-slate-900 no-underline hover:text-blue-600 transition flex items-center justify-between py-3 border-b border-slate-100">
        <span>理念宣言</span>
        <span class="text-xs font-mono text-slate-400">01</span>
      </a>
      <a href="#about" class="mobile-nav-link text-xl font-black text-slate-900 no-underline hover:text-blue-600 transition flex items-center justify-between py-3 border-b border-slate-100">
        <span>3つの柱</span>
        <span class="text-xs font-mono text-slate-400">02</span>
      </a>
      <a href="#events" class="mobile-nav-link text-xl font-black text-slate-900 no-underline hover:text-blue-600 transition flex items-center justify-between py-3 border-b border-slate-100">
        <span>サミット日程</span>
        <span class="text-xs font-mono text-slate-400">03</span>
      </a>
      <a href="#organizer" class="mobile-nav-link text-xl font-black text-slate-900 no-underline hover:text-blue-600 transition flex items-center justify-between py-3 border-b border-slate-100">
        <span>主催・運営体制</span>
        <span class="text-xs font-mono text-slate-400">04</span>
      </a>
      <a href="#contact" class="mobile-nav-link text-xl font-black text-slate-900 no-underline hover:text-blue-600 transition flex items-center justify-between py-3 border-b border-slate-100">
        <span>お問い合わせ</span>
        <span class="text-xs font-mono text-slate-400">05</span>
      </a>
    </nav>

    <div class="pt-6 border-t border-slate-200 space-y-3">
      <a
        href="https://www.instagram.com/pred.studentsummit"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm no-underline shadow-md flex items-center justify-center gap-2 active:scale-98 transition"
      >
        <span>公式Instagramを見る</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <p class="text-center text-[10px] text-slate-400 font-medium">
        © 2026 全国生徒会防災サミット
      </p>
    </div>
  </div>

  <!-- メインコンテンツ -->
  <main id="main-content" class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-16 space-y-20 sm:space-y-32 overflow-x-hidden">
    
    <!-- ヒーローセクション -->
    <section class="relative pt-4 sm:pt-10 pb-4 w-full">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] sm:w-[600px] h-[220px] sm:h-[350px] bg-gradient-to-tr from-emerald-200/35 via-sky-200/40 to-orange-200/35 blur-3xl pointer-events-none -z-10 rounded-full"></div>

      <div class="relative z-10 flex flex-col items-center text-center max-w-4xl mx-auto space-y-6 sm:space-y-8">
        
        <!-- 中央シンボルロゴ -->
        <div class="relative flex items-center justify-center group">
          <div class="absolute -inset-3 sm:-inset-4 bg-gradient-to-tr from-emerald-400 via-sky-400 to-orange-400 rounded-full blur-xl sm:blur-2xl opacity-40 group-hover:opacity-70 transition duration-500"></div>
          <img
            src={logoPath}
            alt="全国生徒会防災サミット シンボルマーク"
            class="relative w-20 h-20 sm:w-32 sm:h-32 object-contain rounded-full shadow-[0_8px_24px_rgba(0,0,0,0.08)] transform group-hover:scale-105 transition duration-300"
          />
        </div>

        <!-- キャッチコピー -->
        <div class="space-y-3 sm:space-y-4 px-2">
          <div class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1 sm:py-1.5 rounded-full bg-white/90 border border-slate-200 text-blue-700 text-[11px] sm:text-xs font-bold shadow-xs">
            <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-blue-600 animate-pulse"></span>
            全国中高生主導プロジェクト
          </div>

          <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-slate-900 tracking-tight leading-[1.2] break-words">
            「守られる側」から、<br />
            <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-teal-500 bg-clip-text text-transparent">
              未来を動かす側へ。
            </span>
          </h1>

          <p class="max-w-2xl mx-auto text-xs sm:text-base text-slate-600 leading-relaxed font-medium">
            災害が起きたとき、学校や地域を動かすのは誰だ？<br class="hidden sm:inline" />
            知識を詰め込む避難訓練を超え、全国の生徒会がつながり、本気でディスカッションし、<br class="hidden sm:inline" />
            リアルなアクションへアップデートする1日。
          </p>
        </div>

        <!-- 特大イベントカード -->
        <div class="pt-2 w-full max-w-2xl mx-auto">
          <div class="relative overflow-hidden bg-white/95 rounded-2xl sm:rounded-3xl p-5 sm:p-8 border border-slate-200/90 shadow-[0_12px_36px_rgba(15,23,42,0.05)]">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-orange-400 via-blue-500 to-emerald-400"></div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5 text-left">
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-slate-900 text-white text-[9px] sm:text-[10px] font-black tracking-widest uppercase">
                    NEXT SUMMIT
                  </span>
                  <span class="text-[11px] sm:text-xs font-bold text-orange-600 bg-orange-50 px-2 py-0.5 rounded border border-orange-100">
                    エントリー受付中
                  </span>
                </div>
                
                <h3 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">
                  2026 全国生徒会防災サミット 秋の陣
                </h3>
                
                <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 text-xs font-semibold text-slate-600">
                  <span class="text-blue-600 font-mono font-bold">2026.09.13 (Sun) 17:00–19:00</span>
                  <span class="text-slate-300 hidden sm:inline">/</span>
                  <span>Zoom オンライン配信</span>
                </div>
              </div>

              <!-- CTAボタン -->
              <a
                href="https://www.instagram.com/pred.studentsummit"
                target="_blank"
                rel="noopener noreferrer"
                class="relative inline-flex items-center justify-center p-0.5 overflow-hidden rounded-xl sm:rounded-2xl group shrink-0 w-full sm:w-auto no-underline"
              >
                <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-blue-600 via-indigo-600 to-sky-400 rounded-xl sm:rounded-2xl blur-xs opacity-60 group-hover:opacity-100 transition duration-300"></span>
                <span class="relative w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl sm:rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-xs sm:text-sm font-bold shadow-md transition duration-200 group-hover:scale-[1.02] active:scale-[0.98]">
                  <span>特設案内を見る</span>
                  <svg class="w-3.5 h-3.5 transition duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </span>
              </a>
            </div>

            <div class="mt-4 pt-3.5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-[10px] sm:text-[11px] text-slate-400">
              <span>主催：特定非営利活動法人日本若者防災復興協会（JYRAC）</span>
              <span>対象：全国の中学・高校生 / 参加無料</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 理念宣言 -->
    <section id="statement" class="relative scroll-mt-20">
      <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-white/90 backdrop-blur-md p-6 sm:p-14 border border-slate-200/90 shadow-xs">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-orange-400 via-blue-500 to-emerald-400"></div>

        <div class="relative z-10 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-bold tracking-widest uppercase mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
          OUR STATEMENT
        </div>

        <h2 class="relative z-10 text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight mb-6">
          「誰かの防災」から、<br />
          <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-emerald-500 bg-clip-text text-transparent">
            「僕らのリアル」へ。
          </span>
        </h2>

        <div class="relative z-10 space-y-5 text-xs sm:text-base leading-relaxed text-slate-600 font-medium">
          <p class="text-base sm:text-lg font-black text-slate-800">
            災害が起きたとき、動くのは誰だ？
          </p>
          <p>
            「若い世代の力」なんて言われるけれど、地域や学校の枠を越えて本気でぶつかり合える場所は、まだ全然足りてない。
          </p>
          <div class="my-4 p-4 sm:p-5 rounded-xl bg-slate-50 border-l-4 border-blue-600">
            <p class="text-sm sm:text-base font-bold text-slate-900">
              だから、全国から仲間を集めてサミットを開くことにした。
            </p>
          </div>
          <p>
            堅苦しい勉強会じゃない。<br />
            プロの話を聞き、カラダを動かして体験し、本音でディスカッションする。<br />
            ただ備えるだけじゃない、自分たちの手で未来のセーフティをつくるための1日。
          </p>
          <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <p class="text-base sm:text-xl font-black text-blue-600">
              次の防災を、ここからアップデートしよう。
            </p>
            <span class="text-[10px] sm:text-xs font-bold tracking-widest text-slate-400 uppercase">
              #STUDENT BOSAI SUMMIT
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3つの柱 (Mission) -->
    <section id="about" class="space-y-8 sm:space-y-12 scroll-mt-20">
      <div class="text-center space-y-2 sm:space-y-3 px-2">
        <p class="text-[11px] sm:text-xs font-black tracking-widest text-blue-600 uppercase">Core Values</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 tracking-tight">3つの柱で育む、実践的防災</h2>
        <p class="text-xs sm:text-sm text-slate-500 max-w-md mx-auto">受動的な座学から、自ら創るリアルなアクションへ。</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        <!-- 01: オレンジ -->
        <div class="relative bg-white p-6 sm:p-8 rounded-2xl sm:rounded-3xl border border-slate-200 shadow-xs flex flex-col justify-between overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-orange-500"></div>
          <div class="space-y-3 sm:space-y-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center font-black text-base sm:text-xl border border-orange-100">01</div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900">知見獲得</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">最前線で活動する専門家や被災地の現場を知るゲストから、教科書や避難訓練では学べない生きた知見を学びます。</p>
          </div>
          <span class="text-[10px] sm:text-[11px] font-black tracking-widest text-orange-600 uppercase mt-4 sm:mt-6 block">KNOWLEDGE</span>
        </div>

        <!-- 02: ブルー -->
        <div class="relative bg-white p-8 rounded-2xl sm:rounded-3xl border border-slate-200 shadow-xs flex flex-col justify-between overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-blue-500"></div>
          <div class="space-y-3 sm:space-y-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center font-black text-base sm:text-xl border border-blue-100">02</div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900">実践ワーク</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">被災状況や学校での避難所設営などを想定した実践的なシミュレーションを通して、身体で動ける対応力を養います。</p>
          </div>
          <span class="text-[10px] sm:text-[11px] font-black tracking-widest text-blue-600 uppercase mt-4 sm:mt-6 block">EXPERIENCE</span>
        </div>

        <!-- 03: グリーン -->
        <div class="relative bg-white p-6 sm:p-8 rounded-2xl sm:rounded-3xl border border-slate-200 shadow-xs flex flex-col justify-between overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-emerald-500"></div>
          <div class="space-y-3 sm:space-y-4">
            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-black text-base sm:text-xl border border-emerald-100">03</div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900">議論・発信</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">学校や地域の枠を越え、互いの生徒会の取り組みやアイデアを持ち寄り共有。次世代からの提言を取りまとめます。</p>
          </div>
          <span class="text-[10px] sm:text-[11px] font-black tracking-widest text-emerald-600 uppercase mt-4 sm:mt-6 block">DISCUSSION</span>
        </div>
      </div>
    </section>

    <!-- 開催一覧 -->
    <section id="events" class="space-y-6 sm:space-y-8 scroll-mt-20">
      <div class="text-center space-y-2 sm:space-y-3 px-2">
        <p class="text-[11px] sm:text-xs font-black tracking-widest text-blue-600 uppercase">Schedule & Lineup</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 tracking-tight">サミット開催スケジュール</h2>
      </div>

      <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200 p-4 sm:p-8 space-y-4 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between p-4 sm:p-5 rounded-xl sm:rounded-2xl bg-slate-50 border border-slate-100 gap-4">
          <div class="space-y-1 sm:space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded-full text-[9px] sm:text-[10px] font-black bg-blue-100 text-blue-700">次回開催</span>
              <span class="text-xs font-mono font-bold text-slate-500">2026.09.13 (Sun)</span>
            </div>
            <h3 class="font-bold text-slate-900 text-base sm:text-lg">2026 全国生徒会防災サミット 秋の陣</h3>
            <p class="text-xs text-slate-500">テーマ：“Think BIG, We’ll Go Further” ｜ 共催：東北生徒会連盟</p>
          </div>
          <a
            href="https://www.instagram.com/pred.studentsummit"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-4 sm:px-5 py-2.5 rounded-xl bg-white border border-slate-300 hover:border-blue-500 hover:text-blue-600 text-slate-800 text-xs font-bold transition shadow-2xs shrink-0 no-underline"
          >
            詳細・参加方法 →
          </a>
        </div>
        <div class="text-center py-2 text-[11px] sm:text-xs text-slate-400 font-medium">
          ※次回以降の開催計画や地方ブロック別のセッションは順次SNS・本サイトにて告知します。
        </div>
      </div>
    </section>

    <!-- 主催組織 -->
    <section id="organizer" class="space-y-6 sm:space-y-8 scroll-mt-20">
      <div class="text-center space-y-2 sm:space-y-3 px-2">
        <p class="text-[11px] sm:text-xs font-black tracking-widest text-slate-400 uppercase">Organizer</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 tracking-tight">主催組織</h2>
      </div>

      <div class="max-w-2xl mx-auto">
        <div class="bg-white p-6 sm:p-10 rounded-2xl sm:rounded-3xl border border-slate-200 shadow-xs space-y-3">
          <span class="text-[11px] sm:text-xs font-black text-blue-600 tracking-wider uppercase">SUMMIT FOUNDER & ORGANIZER</span>
          <h3 class="text-lg sm:text-xl font-black text-slate-900">特定非営利活動法人日本若者防災復興協会（JYRAC）</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
