---
// src/pages/autumn/day3.astro
import Layout from '../../layouts/Layout.astro';

const cleanBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
const logoPath = `${cleanBase}/logo.png`;
const formUrl = "https://docs.google.com/forms/d/e/1FAIpQLSfuLJHFS0j6d95BWNCJ_f5RRiXdGeUnEsea0XvhnYdk_uq72A/viewform?usp=header";
---

<Layout
  title="11月度 秋の陣 DAY 3 | 生徒会防災サミット2026"
  description="2026年11月28日（土）開催。生徒会防災サミット2026 秋の陣 DAY 3。全国の中高生が集う最終セッション。"
>
  <!-- ナビゲーションバー -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-2xs">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-2">
      <a href={`${cleanBase}/`} class="flex items-center gap-2 sm:gap-2.5 no-underline group select-none min-w-0">
        <img src={logoPath} alt="ロゴ" class="w-7 h-7 sm:w-8 sm:h-8 object-contain rounded-full shadow-2xs shrink-0" />
        <div class="flex flex-col truncate">
          <span class="font-black text-slate-900 tracking-tight text-xs sm:text-sm group-hover:text-blue-600 transition truncate">
            生徒会防災サミット
          </span>
          <span class="text-[8px] sm:text-[9px] font-black tracking-widest text-indigo-600 uppercase font-mono">
            DAY 3 / 2026.11.28
          </span>
        </div>
      </a>

      <!-- 戻るボタン -->
      <a
        href={`${cleanBase}/`}
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold text-slate-600 hover:text-blue-600 bg-slate-100/70 hover:bg-slate-200/70 transition shrink-0 no-underline"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span class="hidden sm:inline">トップに戻る</span>
        <span class="sm:hidden">戻る</span>
      </a>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-16 space-y-8 sm:space-y-12">
    
    <!-- メインカード：詳細・受付中 -->
    <div class="relative overflow-hidden bg-white rounded-2xl sm:rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-xs space-y-6 text-left">
      <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-indigo-500 via-blue-500 to-teal-500"></div>

      <!-- ステータスバッジ -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="px-2.5 py-1 rounded bg-indigo-600 text-white text-[10px] font-mono font-black tracking-wider uppercase">
          2026.11.28 SAT
        </span>
        <span class="px-2.5 py-1 rounded bg-emerald-100 text-emerald-800 text-[10px] font-mono font-bold uppercase animate-pulse">
          ENTRY OPEN / 受付中
        </span>
        <span class="px-2.5 py-1 rounded bg-indigo-50 text-indigo-700 text-[11px] font-bold border border-indigo-100">
          秋の陣 最終セッション
        </span>
      </div>

      <!-- タイトル -->
      <div class="space-y-1.5">
        <span class="text-xs font-mono font-bold text-indigo-600">～Think BIG, We’ll Go Further～</span>
        <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-snug">
          生徒会防災サミット2026<br />
          秋の陣 DAY 3
        </h1>
      </div>

      <p class="text-xs sm:text-base text-slate-600 leading-relaxed font-medium">
        9月の「DAY 1」、10月の「DAY 2」に続く、秋の陣シリーズの集大成セッション。<br class="hidden sm:inline" />
        全国の中高生・生徒会が集い、実践成果の発表と共同提言の取りまとめを行います。
      </p>

      <!-- 概要枠 -->
      <div class="p-4 sm:p-5 rounded-xl bg-slate-50 border border-slate-200/80 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm font-semibold text-slate-700">
        <div class="flex items-center gap-1.5">
          <span>📅</span> <span><strong>日時：</strong>2026年11月28日（土）</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span>💻</span> <span><strong>会場：</strong>オンライン（Zoom）</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span>👥</span> <span><strong>対象：</strong>全国の中学生・高校生（生徒会・有志）</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span>🎫</span> <span><strong>参加費：</strong>完全無料</span>
        </div>
      </div>

      <!-- CTA（Googleフォーム直リンク） -->
      <div class="pt-2 flex flex-col sm:flex-row items-center gap-3">
        <a
          href={formUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 text-white font-black text-xs sm:text-sm no-underline shadow-md hover:scale-[1.02] active:scale-98 transition"
        >
          <span>DAY 3 に参加申し込む（Googleフォーム） ↗</span>
        </a>

        <a
          href="https://www.instagram.com/pred.studentsummit"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-3.5 rounded-xl bg-white border border-slate-300 hover:border-indigo-400 text-slate-700 hover:text-indigo-600 text-xs sm:text-sm font-bold no-underline transition shadow-2xs"
        >
          <span>公式Instagramを見る</span>
        </a>
      </div>
    </div>

    <!-- シリーズの流れ（DAY1〜DAY3） -->
    <div class="space-y-4 text-left">
      <h2 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">
        秋の陣 シリーズ一覧
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
        <a href={`${cleanBase}/autumn/day1`} class="p-4 rounded-xl bg-white border border-slate-200 hover:border-blue-400 transition no-underline block space-y-1">
          <div class="flex items-center justify-between">
            <span class="text-slate-500 font-bold font-mono">09.13 SUN</span>
            <span class="text-[9px] bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded font-bold">終了</span>
          </div>
          <h3 class="font-bold text-slate-900 text-sm">DAY 1（9月）</h3>
          <p class="text-slate-500 text-[11px]">卜部教授 特別講演 ＋ グループ対話</p>
        </a>

        <a href={`${cleanBase}/autumn/day2`} class="p-4 rounded-xl bg-white border border-slate-200 hover:border-blue-400 transition no-underline block space-y-1">
          <div class="flex items-center justify-between">
            <span class="text-slate-500 font-bold font-mono">10.24 SAT</span>
            <span class="text-[9px] bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded font-bold">終了</span>
          </div>
          <h3 class="font-bold text-slate-900 text-sm">DAY 2（10月）</h3>
          <p class="text-slate-500 text-[11px]">【考える防災から動く防災へ】</p>
        </a>

        <div class="p-4 rounded-xl bg-indigo-50/50 border-2 border-indigo-500 space-y-1">
          <div class="flex items-center justify-between">
            <span class="text-indigo-600 font-bold font-mono">11.28 SAT</span>
            <span class="text-[9px] bg-indigo-600 text-white px-1.5 py-0.5 rounded font-bold">NOW / 受付中</span>
          </div>
          <h3 class="font-bold text-slate-900 text-sm">DAY 3（11月）</h3>
          <p class="text-slate-600 text-[11px]">成果発表・全国共同提言の策定</p>
        </div>
      </div>
    </div>

    <!-- ボトム導線 -->
    <div class="pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <p>主催：JYRAC（特定非営利活動法人日本若者防災復興協会）</p>
      <a href={`${cleanBase}/`} class="text-blue-600 font-bold hover:underline no-underline">
        トップページに戻る →
      </a>
    </div>

  </main>
</Layout>
