---
// src/pages/autumn/day2.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const cleanBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
const entryFormUrl = "https://forms.gle/KEq9MUEeADgr5mGi9";
---

<Layout 
  title="2026全国生徒会防災サミット 秋の陣 DAY 2 | 詳細・エントリー" 
  description="2026全国生徒会防災サミット 秋の陣 DAY 2。10月24日（土）開催。テーマは【考える防災から動く防災へ】。主催：JYRAC、共催：東北生徒会連合。"
>
  <Header />

  <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 pt-6 sm:pt-12 pb-20 space-y-10 min-w-0">
    
    <!-- パンくず・ヘッダー -->
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-slate-400">
        <a href={`${cleanBase}/`} class="hover:text-blue-600 transition">ホーム</a>
        <span>/</span>
        <span>秋の陣 DAY 2</span>
      </div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
        <span class="text-xs font-black text-blue-700 font-mono">10月24日（土）開催・エントリー受付中</span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 tracking-tight leading-snug break-words">
        2026全国生徒会防災サミット 秋の陣 DAY２
      </h1>
      
      <p class="text-base sm:text-lg font-bold text-blue-600">
        10月のテーマ：【考える防災から動く防災へ】
      </p>
    </div>

    <!-- メインCTAカード（Googleフォームへの導線） -->
    <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white shadow-xl space-y-6">
      <div class="space-y-2">
        <span class="px-3 py-1 rounded-full bg-white/20 text-white text-[10px] font-mono font-bold tracking-wider uppercase">
          ONLINE ZOOM MEETING
        </span>
        <h2 class="text-xl sm:text-2xl font-black tracking-tight">参加エントリー受付中（完全無料）</h2>
        <p class="text-xs sm:text-sm text-blue-100 leading-relaxed">
          全国の中学生・高校生のみなさん、生徒会や防災に関心のある仲間の参加を心よりお待ちしています！
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <a
          href={entryFormUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white text-blue-700 font-black text-sm sm:text-base shadow-md hover:bg-blue-50 active:scale-98 transition no-underline"
        >
          <span>参加フォーム（Googleフォーム）を開く</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- 開催概要セクション -->
    <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs space-y-6 text-left">
      <h2 class="text-lg sm:text-xl font-black text-slate-900 border-b border-slate-100 pb-3">
        開催概要
      </h2>

      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1">
          <dt class="font-mono font-bold text-slate-400 text-xs">名称</dt>
          <dd class="font-bold text-slate-900">2026全国生徒会防災サミット 秋の陣</dd>
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1">
          <dt class="font-mono font-bold text-slate-400 text-xs">主催・共催</dt>
          <dd class="font-bold text-slate-900">主催：JYRAC（日本若者防災復興協会）<br />共催：東北生徒会連合</dd>
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1">
          <dt class="font-mono font-bold text-slate-400 text-xs">開催日時</dt>
          <dd class="font-bold text-slate-900">2026年10月24日（土） 17:00〜19:00（予定）</dd>
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1">
          <dt class="font-mono font-bold text-slate-400 text-xs">会場</dt>
          <dd class="font-bold text-slate-900">Zoom オンライン開催（全国どこからでも参加可能）</dd>
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1 sm:col-span-2">
          <dt class="font-mono font-bold text-slate-400 text-xs">全体テーマ</dt>
          <dd class="font-bold text-slate-900">“Think BIG We’ll Go Further”</dd>
        </div>
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1 sm:col-span-2">
          <dt class="font-mono font-bold text-slate-400 text-xs">開催目的</dt>
          <dd class="font-bold text-slate-900 leading-relaxed">
            全国の中高生が集まり、防災に関してより理解を深めていくこと。また、受け身の防災から一歩進んだ実践力を養います。
          </dd>
        </div>
      </dl>
    </section>

    <!-- プログラム（予定） -->
    <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs space-y-6 text-left">
      <h2 class="text-lg sm:text-xl font-black text-slate-900 border-b border-slate-100 pb-3">
        プログラム（予定）
      </h2>

      <div class="space-y-3">
        <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100">
          <span class="font-mono font-black text-blue-600 text-xs sm:text-sm shrink-0 pt-0.5">17:00</span>
          <div>
            <h3 class="font-black text-slate-900 text-sm sm:text-base">開会</h3>
            <p class="text-xs text-slate-600 mt-0.5">全体オリエンテーション、趣旨説明</p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100">
          <span class="font-mono font-black text-blue-600 text-xs sm:text-sm shrink-0 pt-0.5">17:10</span>
          <div>
            <h3 class="font-black text-slate-900 text-sm sm:text-base">講演</h3>
            <p class="text-xs text-slate-600 mt-0.5">【考える防災から動く防災へ】をテーマにした特別講演・実践アプローチの解説</p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100">
          <span class="font-mono font-black text-blue-600 text-xs sm:text-sm shrink-0 pt-0.5">18:15</span>
          <div>
            <h3 class="font-black text-slate-900 text-sm sm:text-base">成果提案</h3>
            <p class="text-xs text-slate-600 mt-0.5">全国の仲間とグループに分かれての対話ワークおよびアイデア共有</p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100">
          <span class="font-mono font-black text-slate-600 text-xs sm:text-sm shrink-0 pt-0.5">18:50</span>
          <div>
            <h3 class="font-black text-slate-900 text-sm sm:text-base">閉会</h3>
            <p class="text-xs text-slate-600 mt-0.5">まとめ、今後の案内</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 下部に戻るボタン -->
    <div class="pt-4 flex justify-between items-center">
      <a href={`${cleanBase}/`} class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-slate-600 hover:text-blue-600 transition no-underline">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>トップページに戻る</span>
      </a>
      
      <a href={entryFormUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-blue-600 text-white font-bold text-xs sm:text-sm no-underline shadow-md hover:bg-blue-700 transition">
        <span>参加フォームを開く ↗</span>
      </a>
    </div>

  </main>

  <Footer />
</Layout>
